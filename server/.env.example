# Generate different random values for both secrets before deployment.
BUDGET_APP_DB_PASSWORD=replace-with-a-long-random-database-password
BUDGET_APP_JWT_SECRET=replace-with-at-least-32-random-characters
# URL-safe base64 for exactly 32 random bytes. Preserve it with disaster-recovery material.
BUDGET_APP_ATTACHMENT_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# Comma-separated public hostnames accepted by the API (do not include schemes).
BUDGET_APP_ALLOWED_HOSTS=budget.example.com
