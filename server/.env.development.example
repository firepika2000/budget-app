# Local development only. Copy to .env.development; that file is ignored by Git.
BUDGET_APP_DATABASE_URL=postgresql+psycopg://budget:change-this-password@127.0.0.1:5432/budget
BUDGET_APP_JWT_SECRET=replace-with-at-least-32-random-characters
# Optional in development; when absent, attachment encryption derives from the deployment JWT secret.
BUDGET_APP_ATTACHMENT_ENCRYPTION_KEY=
BUDGET_APP_ALLOWED_HOSTS=localhost,127.0.0.1
