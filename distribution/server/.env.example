# Generate this file with: python3 configure.py --allowed-hosts HOSTNAME
# Never reuse these placeholders and never commit the generated .env.
CLEARPOCKET_SERVER_IMAGE=ghcr.io/firepika2000/budget-server
CLEARPOCKET_SERVER_VERSION=edge
CLEARPOCKET_BIND_ADDRESS=127.0.0.1
CLEARPOCKET_PORT=8080
CLEARPOCKET_DATABASE_STORAGE=clearpocket_database
CLEARPOCKET_ATTACHMENTS_STORAGE=clearpocket_attachments
CLEARPOCKET_OPERATIONS_STORAGE=clearpocket_operations
BUDGET_APP_ALLOWED_HOSTS=localhost,127.0.0.1
BUDGET_APP_DB_PASSWORD=GENERATE_A_UNIQUE_SECRET
BUDGET_APP_JWT_SECRET=GENERATE_A_DIFFERENT_UNIQUE_SECRET
BUDGET_APP_ATTACHMENT_ENCRYPTION_KEY=GENERATE_EXACTLY_32_RANDOM_BYTES_AS_BASE64URL
# Generated by --public-host budget.example.com for bundled automatic HTTPS:
# COMPOSE_PROFILES=tls
# CLEARPOCKET_PUBLIC_HOST=budget.example.com
# BUDGET_APP_PAIRING_PUBLIC_URL=https://budget.example.com
# BUDGET_APP_FORWARDED_ALLOW_IPS=*
