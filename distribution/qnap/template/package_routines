CLEARPOCKET_SYSTEM_CONFIG=/etc/config/clearpocket-server.conf

resolve_clearpocket_data_root() {
    # QDK 2.5.3 leaves SYS_QPKG_BASE empty. The selected volume is nevertheless
    # authoritative in SYS_QPKG_INSTALL_PATH (for example
    # /share/CACHEDEV1_DATA/.qpkg), so derive the durable sibling directory from
    # that value instead of falling back to a default/public share.
    case "$SYS_QPKG_INSTALL_PATH" in
        /share/*/.qpkg)
            SELECTED_VOLUME_ROOT=${SYS_QPKG_INSTALL_PATH%/.qpkg}
            ;;
        *)
            case "$SYS_QPKG_DIR" in
                /share/*/.qpkg/*)
                    SELECTED_VOLUME_ROOT=${SYS_QPKG_DIR%/.qpkg/*}
                    ;;
                *)
                    return 1
                    ;;
            esac
            ;;
    esac
    case "$SELECTED_VOLUME_ROOT" in
        /share/*) CLEARPOCKET_RESOLVED_DATA_ROOT="$SELECTED_VOLUME_ROOT/ClearPocketServerData" ;;
        *) return 1 ;;
    esac
}

pkg_check_requirement() {
    CONTAINER_STATION_PATH=$($CMD_GETCFG container-station Install_Path -f /etc/config/qpkg.conf)
    if [ -z "$CONTAINER_STATION_PATH" ]; then
        CONTAINER_STATION_PATH=$($CMD_GETCFG ContainerStation Install_Path -f /etc/config/qpkg.conf)
    fi
    if [ -z "$CONTAINER_STATION_PATH" ]; then
        err_log "QNAP Container Station must be installed before ClearPocket Server."
        return 1
    fi
    return 0
}

pkg_install() {
    if [ ! -f "$CLEARPOCKET_SYSTEM_CONFIG" ]; then
        resolve_clearpocket_data_root || {
            err_log "ClearPocket could not resolve private storage on the selected QNAP volume."
            return 1
        }
        DATA_ROOT="$CLEARPOCKET_RESOLVED_DATA_ROOT"
        $CMD_ECHO "CLEARPOCKET_DATA_ROOT=$DATA_ROOT" > "$CLEARPOCKET_SYSTEM_CONFIG"
        $CMD_CHMOD 600 "$CLEARPOCKET_SYSTEM_CONFIG"
    fi
    DATA_ROOT=$($CMD_SED -n 's/^CLEARPOCKET_DATA_ROOT=//p' "$CLEARPOCKET_SYSTEM_CONFIG")
    if [ -z "$DATA_ROOT" ] || [ ! -x "$SYS_QPKG_DIR/ClearPocketSetup.sh" ]; then
        err_log "ClearPocket persistent data configuration could not be initialized."
        return 1
    fi
    "$SYS_QPKG_DIR/ClearPocketSetup.sh" "$DATA_ROOT" || {
        err_log "ClearPocket private server setup failed."
        return 1
    }
}

pkg_post_install() {
    WEB_LINK=/home/httpd/cgi-bin/qpkg/ClearPocketServer
    WEB_ROOT="$SYS_QPKG_DIR/management"
    if [ ! -x "$WEB_ROOT/index.cgi" ]; then
        err_log "ClearPocket management interface is missing."
        return 1
    fi
    if [ ! -f "$WEB_ROOT/.csrf-token" ]; then
        umask 077
        od -An -N32 -tx1 /dev/urandom | tr -d ' \n' > "$WEB_ROOT/.csrf-token" || {
            err_log "ClearPocket management protection could not be initialized."
            return 1
        }
    fi
    $CMD_CHMOD 600 "$WEB_ROOT/.csrf-token"
    $CMD_MKDIR -p /home/httpd/cgi-bin/qpkg
    $CMD_RM -f "$WEB_LINK"
    $CMD_LN -s "$WEB_ROOT" "$WEB_LINK" || {
        err_log "ClearPocket management interface could not be registered with QTS."
        return 1
    }
}

PKG_PRE_REMOVE="{
    /bin/rm -f /home/httpd/cgi-bin/qpkg/ClearPocketServer
}"

# Deliberately do not define a remove routine for the system configuration or data root. Removing
# the QPKG removes replaceable program files only; customer database and attachments remain.
